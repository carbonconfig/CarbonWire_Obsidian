{
  "name": "carbonwire",
  "version": "1.0.0",
  "description": "Fast REST API client for Obsidian with Postman, Insomnia, Bruno and curl import, environments, history and collections stored as plain YAML files.",
  "author": "CarbonConfig",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "rest-client",
    "api-client",
    "http-client",
    "api-testing",
    "postman",
    "rest-api",
    "insomnia",
    "bruno",
    "httpie",
    "hoppscotch",
    "curl",
    "opencollection"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "analyze": "node esbuild.config.mjs analyze",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "@opencollection/types": "0.14.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "obsidian": "1.14.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carbonconfig/CarbonWire_Obsidian.git"
  }
}
